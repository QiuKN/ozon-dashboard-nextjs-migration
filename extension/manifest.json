{
  "manifest_version": 3,
  "name": "Ozon 选品采集助手",
  "version": "0.1.0",
  "description": "按筛选条件自动采集 Ozon 商品，并交给本地选品页保存和导出。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://ozon.ru/product/*",
    "https://*.ozon.ru/product/*",
    "https://ozon.com/product/*",
    "https://*.ozon.com/product/*",
    "https://ozon-dashboard-nextjs-migration.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ozon.ru/product/*",
        "https://*.ozon.ru/product/*",
        "https://ozon.com/product/*",
        "https://*.ozon.com/product/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ozon-dashboard-nextjs-migration.vercel.app/product-capture*"],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "设置 Ozon 自动采集", "default_popup": "popup.html" }
}
