{
  "manifest_version": 3,
  "name": "Ozon 选品采集助手",
  "version": "0.5.4",
  "description": "按筛选条件自动采集 Ozon 商品，并交给本地选品页保存和导出。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "alarms"],
  "host_permissions": [
    "https://ozon.ru/*",
    "https://*.ozon.ru/*",
    "https://ozon.com/*",
    "https://*.ozon.com/*",
    "https://ozon-dashboard-nextjs-migration.vercel.app/*",
    "http://localhost:3000/product-capture*",
    "http://127.0.0.1:3000/product-capture*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ozon.ru/*",
        "https://*.ozon.ru/*",
        "https://ozon.com/*",
        "https://*.ozon.com/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ozon-dashboard-nextjs-migration.vercel.app/product-capture*",
        "http://localhost:3000/product-capture*",
        "http://127.0.0.1:3000/product-capture*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "打开 Ozon 选品侧栏" },
  "side_panel": { "default_path": "popup.html" }
}
